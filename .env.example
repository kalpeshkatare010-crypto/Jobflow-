# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
#
# Milestone 1 needs no settings: the app runs with demonstration data.
# From Milestone 2 the app connects to your Supabase project. Both values are
# found in Supabase: Project Settings > API. The "anon" key is designed to be
# public; Row Level Security protects the data. NEVER put the "service_role"
# key in this file or anywhere in the frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
