// Cloudflare Workers settings for hosting JobFlow's built website.
// The site is static files from `npm run build` (dist/). Unknown paths such as
// /jobs or /invite/abc are answered with index.html so the app's own router
// can show the right screen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobflow",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
